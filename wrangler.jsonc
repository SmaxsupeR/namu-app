// Cloudflare Workers (static assets) settings for the web version. Build: `npm run build:web`.
// The site is the dist/ folder; every app route serves index.html (a single-page app);
// headers come from dist/_headers (copied from public/_headers).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namu-app",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
