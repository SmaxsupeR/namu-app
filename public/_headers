# Cloudflare Pages response headers.
# The database in the browser (expo-sqlite, wa-sqlite) needs SharedArrayBuffer, which browsers
# allow only on cross-origin isolated pages.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Bundles and assets have content hashes in their names: cache them for a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always check for a new app version.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
